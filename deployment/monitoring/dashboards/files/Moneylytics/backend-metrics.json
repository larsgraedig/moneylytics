{
  "title": "Backend Metrics",
  "uid": "moneylytics-metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Environment",
        "current": { "text": "prod", "value": "moneylytics" },
        "options": [
          { "text": "prod", "value": "moneylytics" },
          { "text": "stage", "value": "moneylytics-stage" }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "jvm_memory_used_bytes{namespace=\"$namespace\", area=\"heap\"}",
          "legendFormat": "Used"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "jvm_memory_max_bytes{namespace=\"$namespace\", area=\"heap\"}",
          "legendFormat": "Max"
        }
      ]
    }
  ]
}
