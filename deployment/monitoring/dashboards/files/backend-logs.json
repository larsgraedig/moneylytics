{
  "title": "Backend Logs",
  "uid": "moneylytics-logs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Environment",
        "current": { "text": "moneylytics", "value": "moneylytics" },
        "options": [
          { "text": "prod", "value": "moneylytics" },
          { "text": "stage", "value": "moneylytics-stage" }
        ],
        "hide": 0
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Log Level",
        "current": { "text": "All", "value": "" },
        "options": [
          { "text": "All", "value": "" },
          { "text": "ERROR", "value": "ERROR" },
          { "text": "WARN", "value": "WARN" },
          { "text": "INFO", "value": "INFO" }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Error Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum(count_over_time({namespace=\"$namespace\"} | json | log_level=\"ERROR\" [1h]))",
          "legendFormat": "Errors (1h)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum by (log_level) (count_over_time({namespace=\"$namespace\"} | json [$__interval]))",
          "legendFormat": "{{log_level}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Log Stream",
      "type": "logs",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 20 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "{namespace=\"$namespace\"}${level:raw:| json | log_level=\"$level\":} | json",
          "legendFormat": ""
        }
      ]
    }
  ]
}
