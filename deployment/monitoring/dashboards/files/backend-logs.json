{
  "title": "Backend Logs",
  "uid": "moneylytics-logs",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "loki" },
        "definition": "label_values({service_name=\"api\", container=\"moneylytics\"}, namespace)",
        "query": "label_values({service_name=\"api\", container=\"moneylytics\"}, namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "title": "Logs",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum by (log_level) (count_over_time({namespace=~\"$namespace\", service_name=\"api\", container=\"moneylytics\"} [$__auto]))",
          "legendFormat": "{{log_level}}"
        }
      ]
    },
    {
      "id": 1,
      "title": "Error Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum(count_over_time({namespace=~\"$namespace\", service_name=\"api\", container=\"moneylytics\"} | json | log_level=\"ERROR\" [1h]))",
          "legendFormat": "Errors (1h)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "title": "Warning Count",
      "type": "stat",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "yellow", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum(count_over_time({namespace=~\"$namespace\", service_name=\"api\", container=\"moneylytics\"} | json | log_level=\"WARN\" [1h]))",
          "legendFormat": "Warnings (1h)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 6,
      "title": "Info Count",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "sum(count_over_time({namespace=~\"$namespace\", service_name=\"api\", container=\"moneylytics\"} | json | log_level=\"INFO\" [1h]))",
          "legendFormat": "Info (1h)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Log Stream",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 20 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "pattern": "Time|log_level|message" }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "log_level": "Level",
              "message": "Message"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "loki" },
          "expr": "{namespace=~\"$namespace\", service_name=\"api\", container=\"moneylytics\"} | json message, log_level=\"log.level\"",
          "legendFormat": ""
        }
      ]
    }
  ]
}
